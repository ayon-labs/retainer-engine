{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pimcon.retainer-engine.com" }],
      "missing": [{ "type": "query", "key": "utm_source" }],
      "destination": "https://pimcon.retainer-engine.com/?utm_source=pimcon2026&utm_medium=in_person",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pimcon.retainer-engine.com" }],
      "destination": "/pimcon"
    },
    {
      "source": "/confirmed",
      "has": [{ "type": "host", "value": "pimcon.retainer-engine.com" }],
      "destination": "/pimcon/confirmed"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
